<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_4x3"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- 1. 顶部紧凑栏：城市、更新时间、AQI、当前气温、天气与刷新 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <!-- 左侧：城市与更新时间 -->
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_widget_location" />

        <TextView
            android:id="@+id/widget_city_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="南昌"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginLeft="3dp" />

        <TextView
            android:id="@+id/widget_update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="实时同步"
            android:textSize="9.5sp"
            android:textColor="#94A3B8"
            android:layout_marginLeft="5dp" />

        <LinearLayout
            android:id="@+id/widget_aqi_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_aqi_badge"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:layout_marginLeft="5dp">

            <TextView
                android:id="@+id/widget_aqi_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="优 32"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- 弹性空白 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 当前实时气温与现象 -->
        <ImageView
            android:id="@+id/widget_weather_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_weather_sunny" />

        <TextView
            android:id="@+id/widget_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24°"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginLeft="3dp" />

        <TextView
            android:id="@+id/widget_weather_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="晴朗"
            android:textSize="10.5sp"
            android:textColor="#38BDF8"
            android:layout_marginLeft="3dp" />

        <!-- 更换皮肤按钮 -->
        <ImageView
            android:id="@+id/widget_btn_skin"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_widget_skin"
            android:padding="3dp"
            android:layout_marginLeft="4dp" />

        <!-- 刷新按钮 -->
        <ImageView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_widget_refresh"
            android:padding="3dp"
            android:layout_marginLeft="4dp" />
    </LinearLayout>

    <!-- 2. 下半部分双排气象看板：第一排 2小时逐时天气，第二排 每天天气 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 第 1 排：间隔 2 个小时的天气 (6 个时段) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">

            <!-- 逐时 1 (现在) -->
            <LinearLayout
                android:id="@+id/widget_hourly_slot1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/widget_forecast_col_bg"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:paddingLeft="1dp"
                android:paddingRight="1dp"
                android:layout_marginLeft="1dp"
                android:layout_marginRight="1dp">

                <TextView
                    android:id="@+id/widget_h1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="现在"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#38BDF8" />

                <FrameLayout
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_h1_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_weather_sunny" />

                <FrameLayout
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/widget_h1_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24°"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/widget_h1_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 逐时 2 (+2h) -->
            <LinearLayout
                android:id="@+id/widget_hourly_slot2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/widget_forecast_col_bg"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:paddingLeft="1dp"
                android:paddingRight="1dp"
                android:layout_marginLeft="1dp"
                android:layout_marginRight="1dp">

                <TextView
                    android:id="@+id/widget_h2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01:00"
                    android:textSize="9sp"
                    android:textColor="#E2E8F0" />

                <FrameLayout
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_h2_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_weather_cloudy" />

                <FrameLayout
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
