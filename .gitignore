# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# 构建产物：每个版本 30+ MB，进 git 历史会让仓库无限膨胀
*.apk
*.aab
*.exe

# 正式签名证书与口令：绝不能进仓库（debug.keystore 是公开的测试密钥，保留）
android/keystore.properties
android/app/release.keystore
android/app/*.keystore
!android/app/debug.keystore

# generated native folders
/ios
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.cxx/

# Gradle/RN 构建期由 Metro 生成的 JS bundle，clone 后由 gradle 重新生成；必须忽略，
# 否则旧 bundle 会被打包进 APK，导致 JS 改动完全不生效。
android/app/src/main/assets/*.bundle
android/app/src/main/assets/*.hbc
