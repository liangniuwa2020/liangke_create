<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg_4x3"
    android:padding="14dp"
    android:gravity="center_vertical">

    <!-- 左侧：超大数字时钟与日期 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextClock
            android:id="@+id/widget_text_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format24Hour="HH:mm"
            android:format12Hour="HH:mm"
            android:textSize="44sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_date_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10月3日 星期六"
            android:textSize="12sp"
            android:textColor="#E2E8F0"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- 分隔线 -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="48dp"
        android:background="#33FFFFFF"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp" />

    <!-- 右侧：天气信息与城市 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- 城市与刷新 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_widget_location" />

            <TextView
                android:id="@+id/widget_city_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="北京"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginStart="3dp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_btn_refresh"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_widget_refresh" />
        </LinearLayout>

        <!-- 图标与温度 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <ImageView
                android:id="@+id/widget_weather_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_weather_sunny" />

            <TextView
                android:id="@+id/widget_temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24°"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- 状况与高低 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/widget_weather_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="晴朗"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/widget_temp_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="26°/15°"
                android:textSize="10sp"
                android:textColor="#CBD5E1"
                android:layout_marginStart="4dp" />

            <LinearLayout
                android:id="@+id/widget_aqi_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_aqi_badge"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:id="@+id/widget_aqi_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="优"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
