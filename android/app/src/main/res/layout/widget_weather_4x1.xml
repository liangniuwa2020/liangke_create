<?xml version="1.0" encoding="utf-8"?>
<!--
  4×1 精简时钟天气小部件

  【为什么之前「刷新按钮不见了」】
  minWidth = 250dp，减去左右内边距 12dp×2 → 可用宽度约 226dp。
  旧布局把「换肤 / 刷新」放在水平行最后两位，前面是不可压缩的固定宽度：
    时钟列(26sp "HH:mm" + 10sp "11月16日 周日") ≈ 84dp
    + 分隔线及外边距 20dp
    + 中间列(定位图标 + 13sp 城市 + AQI 徽标，第二行 10sp "微风 2级 · 湿度48%") ≈ 104dp
    + 天气图标 28dp + 温度列(20sp 温度 + 10sp "晴 26°/15°") ≈ 86dp
    = 已超过 226dp —— LinearLayout 先把 layout_weight 的弹性间隔压到 0，接着按子 View 顺序继续溢出，
      排在最后的两颗按钮就被裁到可视区之外。用户看到的就是「小部件没有刷新按钮」。

  【现在的约束】
  固定宽度压到 ≈167dp，把唯一可伸缩的 layout_weight=1 交给中间信息列：
    时钟列(20sp "HH:mm" + 8.5sp "11/16 周日") ≈ 50dp
    + 分隔线 1dp + 外边距 8dp
    + 天气图标 20dp + 温度列(16sp 温度 + 8.5sp "晴 26°/15°") ≈ 49dp
    + 换肤 18dp(留 3dp) + 刷新 18dp(留 2dp)
    ≈ 167dp → 中间列稳定拿到 ≈59dp，宽度不够时只截断文字(ellipsize)，按钮永远可见可点。
  按钮视觉尺寸 18dp、点击区由 AppWidget 宿主扩展，配合 contentDescription 可被读屏识别。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg_4x1"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center_vertical">

    <!-- 1. 左侧：时钟与日期（固定宽度） -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextClock
            android:id="@+id/widget_text_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format24Hour="HH:mm"
            android:format12Hour="HH:mm"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_date_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11/16 周日"
            android:textSize="8.5sp"
            android:textColor="#CBD5E1"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />
    </LinearLayout>

    <!-- 竖直半透明分隔线 -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="28dp"
        android:background="#33FFFFFF"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp" />

    <!-- 2. 中间：城市 + AQI + 风力湿度（唯一可伸缩区域，超长文字自动省略） -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_city_name"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="南昌"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:id="@+id/widget_aqi_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_aqi_badge"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginLeft="4dp">

                <TextView
                    android:id="@+id/widget_aqi_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="优 32"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_sub_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="微风 2级 · 湿度48%"
            android:textSize="8.5sp"
            android:textColor="#94A3B8"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />
    </LinearLayout>

    <!-- 3. 右侧：天气图标 + 温度 + 现况（固定宽度） -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_weather_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_weather_sunny" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end|center_vertical"
            android:layout_marginLeft="3dp">

            <TextView
                android:id="@+id/widget_temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24°"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_weather_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="晴 26°/15°"
                android:textSize="8.5sp"
                android:textColor="#E2E8F0"
                android:maxLines="1"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- 换肤按钮：固定 18dp，排在行尾倒数第二，永不参与压缩 -->
        <ImageView
            android:id="@+id/widget_btn_skin"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_skin"
            android:padding="1dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_btn_skin_desc"
            android:layout_marginLeft="3dp" />

        <!-- 刷新按钮：固定 18dp，始终位于最右侧。这个 id 被 Provider 绑定点击事件，
             一旦被布局挤出可视区，用户就会觉得「刷新按钮消失了」，因此任何宽度调整都要复核总宽。 -->
        <ImageView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_refresh"
            android:padding="1dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_btn_refresh_desc"
            android:layout_marginLeft="2dp" />
    </LinearLayout>

</LinearLayout>
