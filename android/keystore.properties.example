# 正式发布签名配置示例
#
# 用法：复制本文件为 android/keystore.properties，填入你自己的密钥信息，
#       并把 release.keystore 放到 android/app/ 目录下（或改 storeFile 指向别处）。
#       这两个文件都已在 .gitignore 中被忽略，请勿提交。
#
# 生成密钥库：
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore android/app/release.keystore -alias noadweather \
#     -keyalg RSA -keysize 2048 -validity 10950
#
# 注意：密钥库一旦丢失，后续版本将无法覆盖安装（用户会看到「应用未安装」），
#       请务必离线备份 release.keystore 与口令。

storeFile=app/release.keystore
storePassword=PUT_YOUR_STORE_PASSWORD_HERE
keyAlias=noadweather
keyPassword=PUT_YOUR_KEY_PASSWORD_HERE
