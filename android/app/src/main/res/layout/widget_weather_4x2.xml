                <TextView
                    android:id="@+id/widget_h6_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="23°"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/widget_h6_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- 第 2 排：未来 6 天 (每天天气) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- 预报 1 (今天) -->
            <LinearLayout
                android:id="@+id/widget_forecast_day1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/widget_forecast_col_bg"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:paddingLeft="1dp"
                android:paddingRight="1dp"
                android:layout_marginLeft="1dp"
                android:layout_marginRight="1dp">

                <TextView
                    android:id="@+id/widget_f1_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="今天"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#38BDF8" />

                <FrameLayout
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_f1_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_weather_sunny" />

                <FrameLayout
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/widget_f1_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="26°/15°"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- 预报 2 (明天) -->
            <LinearLayout
                android:id="@+id/widget_forecast_day2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/widget_forecast_col_bg"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:paddingLeft="1dp"
                android:paddingRight="1dp"
                android:layout_marginLeft="1dp"
                android:layout_marginRight="1dp">

                <TextView
                    android:id="@+id/widget_f2_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="明天"
                    android:textSize="9sp"
                    android:textColor="#E2E8F0" />

                <FrameLayout
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_f2_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_weather_cloudy" />

                <FrameLayout
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/widget_f2_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25°/14°"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- 预报 3 (后天) -->
            <LinearLayout
                android:id="@+id/widget_forecast_day3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/widget_forecast_col_bg"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:paddingLeft="1dp"
                android:paddingRight="1dp"
                android:layout_marginLeft="1dp"
                android:layout_marginRight="1dp">

                <TextView
                    android:id="@+id/widget_f3_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="后天"
                    android:textSize="9sp"
                    android:textColor="#E2E8F0" />

                <FrameLayout
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_f3_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_weather_rainy" />

                <FrameLayout
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/widget_f3_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="23°/13°"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- 预报 4 -->
            <LinearLayout
                android:id="@+id/widget_forecast_day4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/widget_forecast_col_bg"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:paddingLeft="1dp"
                android:paddingRight="1dp"
                android:layout_marginLeft="1dp"
                android:layout_marginRight="1dp">

                <TextView
                    android:id="@+id/widget_f4_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="周二"
                    android:textSize="9sp"
                    android:textColor="#E2E8F0" />

                <FrameLayout
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_f4_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_weather_cloudy" />

                <FrameLayout
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/widget_f4_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="22°/12°"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- 预报 5 -->
            <LinearLayout
                android:id="@+id/widget_forecast_day5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/widget_forecast_col_bg"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:paddingLeft="1dp"
                android:paddingRight="1dp"
                android:layout_marginLeft="1dp"
                android:layout_marginRight="1dp">

                <TextView
                    android:id="@+id/widget_f5_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="周三"
                    android:textSize="9sp"
                    android:textColor="#E2E8F0" />

                <FrameLayout
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_f5_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_weather_sunny" />

                <FrameLayout
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/widget_f5_temp"
                    android:layout_width="wrap_content"
