<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_4x3"
    android:padding="14dp">

    <!-- 1. 顶部栏：城市与刷新 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_widget_location" />

        <TextView
            android:id="@+id/widget_city_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="北京"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginStart="4dp" />

        <TextView
            android:id="@+id/widget_update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="实时同步"
            android:textSize="10sp"
            android:textColor="#94A3B8"
            android:layout_marginStart="6dp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:padding="2dp"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <!-- 2. 主体区：左侧数字时钟与日期，右侧气温与天气现象 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- 左侧：大号实时走字数字时钟 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextClock
                android:id="@+id/widget_text_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format24Hour="HH:mm"
                android:format12Hour="HH:mm"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_date_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10月3日 周六"
                android:textSize="11sp"
                android:textColor="#E2E8F0"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 右侧：天气图标与温度 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end|center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_weather_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_weather_sunny" />

                <TextView
                    android:id="@+id/widget_temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24°"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:includeFontPadding="false"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/widget_weather_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="晴朗"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/widget_temp_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="26° / 15°"
                    android:textSize="11sp"
                    android:textColor="#CBD5E1"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 3. 指数指标胶囊条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_pill_bg"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:id="@+id/widget_aqi_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_aqi_badge"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/widget_aqi_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="优 32"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_wind_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="微风 2级"
            android:textSize="11sp"
            android:textColor="#E2E8F0"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/widget_humidity_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="湿度 48%"
            android:textSize="11sp"
            android:textColor="#E2E8F0"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/widget_air_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="体感舒适"
            android:textSize="11sp"
            android:textColor="#93C5FD" />
    </LinearLayout>

    <!-- 4. 底部未来 3 天气温趋势卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- 第 1 天 -->
        <LinearLayout
            android:id="@+id/widget_forecast_day1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_forecast_col_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="3dp">

            <TextView
                android:id="@+id/widget_f1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="明天"
                android:textSize="11sp"
                android:textColor="#E2E8F0" />

            <ImageView
                android:id="@+id/widget_f1_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_weather_sunny"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp" />

            <TextView
                android:id="@+id/widget_f1_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="晴"
                android:textSize="10sp"
                android:textColor="#CBD5E1" />

            <TextView
                android:id="@+id/widget_f1_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25° / 14°"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 第 2 天 -->
        <LinearLayout
            android:id="@+id/widget_forecast_day2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_forecast_col_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp">

            <TextView
                android:id="@+id/widget_f2_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="后天"
                android:textSize="11sp"
                android:textColor="#E2E8F0" />

            <ImageView
                android:id="@+id/widget_f2_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_weather_cloudy"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp" />

            <TextView
                android:id="@+id/widget_f2_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="多云"
                android:textSize="10sp"
                android:textColor="#CBD5E1" />

            <TextView
                android:id="@+id/widget_f2_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23° / 13°"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 第 3 天 -->
        <LinearLayout
            android:id="@+id/widget_forecast_day3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_forecast_col_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginStart="3dp">

            <TextView
                android:id="@+id/widget_f3_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="大后天"
                android:textSize="11sp"
                android:textColor="#E2E8F0" />

            <ImageView
                android:id="@+id/widget_f3_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_weather_rainy"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp" />

            <TextView
                android:id="@+id/widget_f3_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="小雨"
                android:textSize="10sp"
                android:textColor="#CBD5E1" />

            <TextView
                android:id="@+id/widget_f3_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="21° / 12°"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
