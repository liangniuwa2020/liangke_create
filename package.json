{
  "name": "no-ad-weather",
  "version": "1.2.5",
  "main": "index.js",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.18",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.33",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/verify_refresh.js",
    "test:policy": "node scripts/test_refresh_policy.mjs",
    "test:overnight": "node scripts/test_overnight_refresh.mjs",
    "test:refresh": "node scripts/verify_refresh.js && node scripts/test_refresh_policy.mjs && node scripts/test_overnight_refresh.mjs",
    "test:forecast": "node scripts/test_forecast_days.mjs",
    "test:forecast:ui": "node --import ./scripts/register-render.mjs scripts/test_forecast_ui.mjs",
    "test:app": "node --import ./scripts/register-render.mjs scripts/test_app_smoke.mjs",
    "test:forecast:all": "npm run test:forecast && npm run test:forecast:ui && npm run test:app"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "private": true
}