<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_4x3"
    android:padding="12dp">

    <!-- 1. 顶部栏：城市、定位、空气质量指标 与 当前气温、刷新 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- 左侧：城市与更新时间 -->
        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/ic_widget_location" />

        <TextView
            android:id="@+id/widget_city_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="南昌"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginLeft="4dp" />

        <TextView
            android:id="@+id/widget_update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="实时同步"
            android:textSize="10sp"
            android:textColor="#94A3B8"
            android:layout_marginLeft="6dp" />

        <LinearLayout
            android:id="@+id/widget_aqi_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_aqi_badge"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:layout_marginLeft="6dp">

            <TextView
                android:id="@+id/widget_aqi_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="优 32"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- 弹性空白 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 当前实时气温与现象 -->
        <ImageView
            android:id="@+id/widget_weather_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_weather_sunny" />

        <TextView
            android:id="@+id/widget_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24°"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginLeft="4dp" />

        <TextView
            android:id="@+id/widget_weather_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="晴朗"
            android:textSize="11sp"
            android:textColor="#E2E8F0"
            android:layout_marginLeft="4dp" />

        <!-- 刷新按钮 -->
        <ImageView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_widget_refresh"
            android:padding="1dp"
            android:layout_marginLeft="8dp" />
    </LinearLayout>

    <!-- 2. 最近 24 小时逐时天气预报栏 (6个代表时间节点) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 节点 1 (当前/现在) -->
        <LinearLayout
            android:id="@+id/widget_hourly_slot1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_forecast_col_bg"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingLeft="1dp"
            android:paddingRight="1dp"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="1dp">

            <TextView
                android:id="@+id/widget_h1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="现在"
                android:textSize="10sp"
                android:textColor="#E2E8F0" />

            <ImageView
                android:id="@+id/widget_h1_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_weather_sunny"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/widget_h1_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24°"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/widget_h1_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="晴"
                android:textSize="9sp"
                android:textColor="#CBD5E1"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- 节点 2 (+4小时) -->
        <LinearLayout
            android:id="@+id/widget_hourly_slot2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_forecast_col_bg"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingLeft="1dp"
            android:paddingRight="1dp"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="1dp">

            <TextView
                android:id="@+id/widget_h2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01:00"
                android:textSize="10sp"
                android:textColor="#E2E8F0" />

            <ImageView
                android:id="@+id/widget_h2_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_weather_cloudy"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/widget_h2_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22°"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/widget_h2_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="多云"
                android:textSize="9sp"
                android:textColor="#CBD5E1"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- 节点 3 (+8小时) -->
        <LinearLayout
            android:id="@+id/widget_hourly_slot3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_forecast_col_bg"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingLeft="1dp"
            android:paddingRight="1dp"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="1dp">

            <TextView
                android:id="@+id/widget_h3_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05:00"
                android:textSize="10sp"
                android:textColor="#E2E8F0" />

            <ImageView
                android:id="@+id/widget_h3_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_weather_cloudy"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/widget_h3_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20°"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/widget_h3_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="阴"
                android:textSize="9sp"
                android:textColor="#CBD5E1"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- 节点 4 (+12小时) -->
        <LinearLayout
            android:id="@+id/widget_hourly_slot4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_forecast_col_bg"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingLeft="1dp"
            android:paddingRight="1dp"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="1dp">

            <TextView
                android:id="@+id/widget_h4_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:00"
                android:textSize="10sp"
                android:textColor="#E2E8F0" />

            <ImageView
                android:id="@+id/widget_h4_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_weather_sunny"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/widget_h4_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25°"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/widget_h4_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="晴"
                android:textSize="9sp"
                android:textColor="#CBD5E1"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- 节点 5 (+16小时) -->
        <LinearLayout
            android:id="@+id/widget_hourly_slot5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_forecast_col_bg"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingLeft="1dp"
            android:paddingRight="1dp"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="1dp">

            <TextView
                android:id="@+id/widget_h5_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13:00"
                android:textSize="10sp"
                android:textColor="#E2E8F0" />

            <ImageView
                android:id="@+id/widget_h5_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_weather_sunny"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/widget_h5_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="27°"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/widget_h5_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="晴"
                android:textSize="9sp"
                android:textColor="#CBD5E1"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- 节点 6 (+20小时) -->
        <LinearLayout
            android:id="@+id/widget_hourly_slot6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_forecast_col_bg"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingLeft="1dp"
            android:paddingRight="1dp"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="1dp">

            <TextView
                android:id="@+id/widget_h6_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17:00"
                android:textSize="10sp"
                android:textColor="#E2E8F0" />

            <ImageView
                android:id="@+id/widget_h6_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_weather_rainy"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/widget_h6_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23°"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/widget_h6_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="小雨"
                android:textSize="9sp"
                android:textColor="#CBD5E1"
                android:layout_marginTop="1dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
