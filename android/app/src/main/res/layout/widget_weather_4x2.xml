                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/widget_h5_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 逐时 6 (+10h) -->
            <LinearLayout
                android:id="@+id/widget_hourly_slot6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/widget_forecast_col_bg"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:paddingLeft="1dp"
                android:paddingRight="1dp"
                android:layout_marginLeft="1dp"
                android:layout_marginRight="1dp">

                <TextView
                    android:id="@+id/widget_h6_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:00"
                    android:textSize="9sp"
                    android:textColor="#E2E8F0" />

                <FrameLayout
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_h6_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_weather_rainy" />

                <FrameLayout
                    android:layout_width="1dp"
                    android:layout_height="0dp"
