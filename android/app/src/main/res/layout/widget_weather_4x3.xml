<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_4x3"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- 1. 顶部栏：城市、定位与刷新 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_widget_location" />

        <TextView
            android:id="@+id/widget_city_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="北京"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginLeft="4dp" />

        <TextView
            android:id="@+id/widget_update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="实时同步"
            android:textSize="10sp"
            android:textColor="#94A3B8"
            android:layout_marginLeft="6dp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:padding="2dp"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <!-- 2. 主体区：左侧数字时钟与日期，右侧气温与天气现象 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- 左侧：大号实时走字数字时钟 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextClock
                android:id="@+id/widget_text_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format24Hour="HH:mm"
                android:format12Hour="HH:mm"
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_date_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10月3日 周六"
                android:textSize="11.5sp"
                android:textColor="#CBD5E1"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 右侧：天气图标与温度 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end|center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_weather_icon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_weather_sunny" />

                <TextView
                    android:id="@+id/widget_temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24°"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:includeFontPadding="false"
                    android:layout_marginLeft="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/widget_weather_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="晴朗"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#38BDF8" />

                <TextView
                    android:id="@+id/widget_temp_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="26° / 15°"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:layout_marginLeft="6dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 3. 指数指标胶囊条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_pill_bg"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:id="@+id/widget_aqi_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_aqi_badge"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/widget_aqi_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="优 32"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_wind_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="微风 2级"
            android:textSize="11sp"
            android:textColor="#E2E8F0"
            android:layout_marginLeft="8dp" />

        <TextView
            android:id="@+id/widget_humidity_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="湿度 48%"
            android:textSize="11sp"
            android:textColor="#E2E8F0"
            android:layout_marginLeft="8dp" />

        <TextView
            android:id="@+id/widget_air_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="体感舒适"
            android:textSize="11sp"
            android:textColor="#93C5FD" />
    </LinearLayout>

    <!-- 4. 底部未来 7 天 (最近一周) 天气趋势卡片：垂直铺满剩余空间，彻底消除底部留白 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 第 1 天 (今天) -->
        <LinearLayout
            android:id="@+id/widget_forecast_day1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_forecast_col_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp">

            <TextView
                android:id="@+id/widget_f1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今天"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#38BDF8" />

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_f1_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_weather_sunny" />

            <TextView
                android:id="@+id/widget_f1_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="晴"
                android:textSize="10sp"
                android:textColor="#CBD5E1"
                android:layout_marginTop="2dp" />

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_f1_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="26°/15°"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- 第 2 天 (明天) -->
        <LinearLayout
            android:id="@+id/widget_forecast_day2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_forecast_col_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp">

            <TextView
                android:id="@+id/widget_f2_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="明天"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_f2_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_weather_cloudy" />

            <TextView
                android:id="@+id/widget_f2_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="多云"
                android:textSize="10sp"
                android:textColor="#CBD5E1"
                android:layout_marginTop="2dp" />

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_f2_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25°/14°"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- 第 3 天 (后天) -->
        <LinearLayout
            android:id="@+id/widget_forecast_day3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_forecast_col_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp">

            <TextView
                android:id="@+id/widget_f3_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="后天"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_f3_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_weather_rainy" />

            <TextView
                android:id="@+id/widget_f3_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="小雨"
                android:textSize="10sp"
                android:textColor="#CBD5E1"
                android:layout_marginTop="2dp" />

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_f3_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23°/13°"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- 第 4 天 -->
        <LinearLayout
            android:id="@+id/widget_forecast_day4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_forecast_col_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp">

            <TextView
                android:id="@+id/widget_f4_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="周二"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_f4_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_weather_cloudy" />

            <TextView
                android:id="@+id/widget_f4_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="阴"
                android:textSize="10sp"
                android:textColor="#CBD5E1"
                android:layout_marginTop="2dp" />

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_f4_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22°/12°"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- 第 5 天 -->
        <LinearLayout
            android:id="@+id/widget_forecast_day5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_forecast_col_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp">

            <TextView
                android:id="@+id/widget_f5_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="周三"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_f5_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_weather_sunny" />

            <TextView
                android:id="@+id/widget_f5_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="晴"
                android:textSize="10sp"
                android:textColor="#CBD5E1"
                android:layout_marginTop="2dp" />

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_f5_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24°/13°"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- 第 6 天 -->
        <LinearLayout
            android:id="@+id/widget_forecast_day6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_forecast_col_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp">

            <TextView
                android:id="@+id/widget_f6_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="周四"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_f6_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_weather_rainy" />

            <TextView
                android:id="@+id/widget_f6_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="中雨"
                android:textSize="10sp"
                android:textColor="#CBD5E1"
                android:layout_marginTop="2dp" />

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_f6_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20°/11°"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- 第 7 天 -->
        <LinearLayout
            android:id="@+id/widget_forecast_day7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_forecast_col_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp">

            <TextView
                android:id="@+id/widget_f7_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="周五"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_f7_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_weather_sunny" />

            <TextView
                android:id="@+id/widget_f7_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="晴"
                android:textSize="10sp"
                android:textColor="#CBD5E1"
                android:layout_marginTop="2dp" />

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_f7_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23°/12°"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
